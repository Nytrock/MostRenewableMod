		DraedonsLogJungle.SalesPitch: "{$NPC.SalesmanLogPitch}"
		DraedonsLogPlanetoid.SalesPitch: "{$NPC.SalesmanLogPitch}"
		DraedonsLogHell.SalesPitch: "{$NPC.SalesmanLogPitch}"
		DraedonsLogSnowBiome.SalesPitch: "{$NPC.SalesmanLogPitch}"
